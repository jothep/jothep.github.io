{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local development only. Use the separate production example after review.
  "name": "homepage-counter-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "vars": { "ALLOWED_ORIGIN": "http://127.0.0.1:8776" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homepage-counter-local",
      "database_id": "local-only",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
}
